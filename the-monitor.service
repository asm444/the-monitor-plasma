[Unit]
Description=The Monitor hub: runs one agent per device in ~/.config/the-monitor/config.toml
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 -I %h/.local/share/the-monitor/hub.py
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=yes
Slice=background.slice

[Install]
WantedBy=default.target
